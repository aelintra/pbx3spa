# Copy to .env.development and adjust. (.env.development is gitignored.)

# PBX3 API origin for Vite proxy (/api → this host). No trailing /api path.
VITE_API_PROXY_TARGET=https://08jzwn.pbx3.com:44300

# Fleet catalog (Phase 2). Omit for solo login.
#
# Local dev (no S3 CORS) — proxy through Vite:
# VITE_CATALOG_PROXY_TARGET=https://08jzwn-pbx3.s3.us-east-1.amazonaws.com
# VITE_INSTANCE_DIRECTORY_URL=/dev-catalog/catalog/instance-index.json
# B′ tenant-home (optional; defaults to sibling tenant-home.json next to instance-index):
# VITE_TENANT_HOME_URL=/dev-catalog/catalog/tenant-home.json
#
# Or direct S3 URL (requires bucket CORS for http://localhost:5173):
# VITE_INSTANCE_DIRECTORY_URL=https://08jzwn-pbx3.s3.us-east-1.amazonaws.com/catalog/instance-index.json

# Optional solo pre-fill when directory URL is unset:
# VITE_DEFAULT_API_BASE_URL=https://08jzwn.pbx3.com:44300/api

# Line quality test WSS (Tools panel). Default without this: wss://sbc.pbx3.com:8089/ws
# Lab SBC: VITE_LINE_TEST_WSS_URL=wss://192.168.1.85:8089/ws

# Build-time fallback for idle logout before instance globals load (minutes). Instance
# Globals sessiontimout (seconds) wins at runtime once GET sysglobals succeeds.
# VITE_AUTO_LOGOUT_MINUTES=10

# Fleet gatekeeper (S8.10 move wizard).
# Direct (CORS enabled on gatekeeper):
# VITE_FLEET_GATEKEEPER_URL=http://127.0.0.1:8090
# Or via Vite proxy (restart npm run dev after changing):
# VITE_FLEET_GATEKEEPER_PROXY_TARGET=http://127.0.0.1:8090
# VITE_FLEET_GATEKEEPER_URL=/fleet-gk
# Optional DEV-only convenience (ignored in production builds — use Fleet tenants session paste):
# VITE_FLEET_GATEKEEPER_TOKEN=movewizard-smoke-token
